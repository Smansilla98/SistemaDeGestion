# Conurbania Mobile (Expo)

# API del backend (incluye /api)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# development | staging | production
APP_ENV=development

# Obligatorio para builds EAS (push, OTA, project linking).
# Generar con: eas init   →  copiar el projectId
# O setear secret: eas secret:create --name EAS_PROJECT_ID --value <uuid>
EAS_PROJECT_ID=8079310e-3205-4c1e-88d3-22964fb97c60

# Opcional: path a google-services.json para FCM en Android
# GOOGLE_SERVICES_JSON=
