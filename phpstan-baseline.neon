parameters:
	ignoreErrors:
		-
			message: "#^Dead catch \\- ReflectionException is never thrown in the try block\\.$#"
			count: 1
			path: app/Core/Container.php

		-
			message: "#^Strict comparison using \\=\\=\\= between object and null will always evaluate to false\\.$#"
			count: 1
			path: app/Core/Container.php

		-
			message: "#^Method App\\\\Exports\\\\OrdersExport\\:\\:query\\(\\) has invalid return type Laravel\\\\Scout\\\\Builder\\.$#"
			count: 1
			path: app/Exports/OrdersExport.php

		-
			message: "#^Method App\\\\Exports\\\\ProductsExport\\:\\:query\\(\\) has invalid return type Laravel\\\\Scout\\\\Builder\\.$#"
