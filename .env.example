APP_NAME="Conurbania"
APP_BRAND_NAME=Conurbania
# Ruta relativa a public/. Dejar vacío para logo genérico.
APP_LOGO=logo.png
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurante_db
DB_USERNAME=user
DB_PASSWORD=

# MySQL estricto (prod/staging/docker). En docker-compose ya se fuerza STRICT_ALL_TABLES.
# En hosts bare-metal: SET GLOBAL sql_mode='STRICT_ALL_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION';
DB_STRICT_MODE=true

# PHP memory (start.sh / docker zz-conurbania.ini). Default seguro: 256M.
PHP_MEMORY_LIMIT=256M

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT (API portfolio). En producción define JWT_SECRET largo y aleatorio (no reutilices APP_KEY si puedes evitarlo).
JWT_SECRET=
JWT_TTL=3600
JWT_REFRESH_TTL=2592000
JWT_ISSUER="${APP_URL}"

# Login demo (Play Store / testers): no crea sesión; responde el mismo mensaje en web y API.
DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_USERNAME=demo
DEMO_LOGIN_PASSWORD=demo1234
DEMO_LOGIN_MESSAGE="hola, gracias por probar la app :)"

# Orígenes permitidos para cargar /docs/openapi.yaml desde otra URL (Swagger en otro servicio Railway). Ej: https://base-sistema-production.up.railway.app
OPENAPI_CORS_ORIGINS=
